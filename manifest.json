{
  "manifest_version": 3,
  "name": "BOAR MD Preview",
  "short_name": "MD Preview",
  "version": "1.0.0",
  "description": "Read Markdown files as clean pages: headings, tables, code, lists, alerts and footnotes. Local files and raw .md on the web. Nothing leaves your browser.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "file:///*.md",
        "file:///*.MD",
        "file:///*.markdown",
        "http://*/*.md",
        "https://*/*.md",
        "http://*/*.markdown",
        "https://*/*.markdown"
      ],
      "js": [
        "md.js",
        "content.js"
      ],
      "css": [
        "style.css"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/Archivo-Variable.ttf"
      ],
      "matches": [
        "file:///*",
        "http://*/*",
        "https://*/*"
      ],
      "use_dynamic_url": true
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
